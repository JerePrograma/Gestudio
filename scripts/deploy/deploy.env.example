# Gestudio Windows deployment. The effective copy lives under .gestudio-deploy/.
COMPOSE_PROJECT_NAME=gestudio-windows
SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=gestudio_db
POSTGRES_USER=gestudio_migrator
POSTGRES_PASSWORD=
POSTGRES_APP_USER=gestudio_runtime
POSTGRES_APP_PASSWORD=
POSTGRES_CONTROL_USER=gestudio_control_runtime
POSTGRES_CONTROL_PASSWORD=
POSTGRES_PORT=25432

BACKEND_PORT=28080
FRONTEND_PORT=28081
BACKEND_IMAGE=gestudio-backend:windows
FRONTEND_IMAGE=gestudio-frontend:windows
VITE_API_BASE_URL=http://127.0.0.1:28080/api
VITE_APP_TIME_ZONE=America/Argentina/Buenos_Aires

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=1
APP_MULTITENANCY_REQUIRED=true

JWT_SECRET=
JWT_ISSUER=gestudio-windows
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D
JWT_PLATFORM_AUDIENCE=gestudio-platform-web
APP_PLATFORM_ACCESS_TOKEN_TTL=PT5M
APP_PLATFORM_REFRESH_TOKEN_TTL=PT8H
APP_PLATFORM_STEP_UP_TTL=PT5M
APP_PLATFORM_MFA_ENCRYPTION_KEY=
APP_PLATFORM_MFA_KEY_VERSION=1
APP_PLATFORM_REFRESH_COOKIE_NAME=gestudio_platform_refresh
APP_PLATFORM_REFRESH_COOKIE_SECURE=false
APP_PLATFORM_REFRESH_COOKIE_SAME_SITE=Strict
APP_PLATFORM_REFRESH_COOKIE_DOMAIN=
APP_PLATFORM_REFRESH_COOKIE_PATH=/api/platform/auth

APP_TIME_ZONE=America/Argentina/Buenos_Aires
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:28081,http://localhost:28081
APP_SCHEDULING_ENABLED=false
APP_OBSERVABILITY_METRICS_TOKEN=
APP_SECURITY_REFRESH_COOKIE_NAME=gestudio_windows_refresh
APP_SECURITY_REFRESH_COOKIE_SECURE=false
APP_SECURITY_REFRESH_COOKIE_SAME_SITE=Strict
APP_SECURITY_REFRESH_COOKIE_DOMAIN=
APP_SECURITY_REFRESH_COOKIE_PATH=/api/login

# The first platform SUPERADMIN is created separately after deploy:
# scripts/ops/bootstrap-platform-admin.ps1 -EnvFile <effective-env> -ProjectName <project> -Username <user> -RecoveryCodesPath <new-private-file> -ConfirmBootstrap
# Ordinary deployment never enables bootstrap.
APP_LOCAL_ADMIN_PASSWORD_RESET_ENABLED=false
APP_LOCAL_ADMIN_PASSWORD_RESET_USERNAME=
APP_LOCAL_ADMIN_PASSWORD_RESET_PASSWORD=

# Real email traffic remains fail-closed.
APP_EMAIL_ENABLED=false
APP_EMAIL_PROVIDER=NOOP
APP_EMAIL_DRY_RUN=true
APP_EMAIL_REAL_NETWORK_ALLOWED=false
APP_EMAIL_KILL_SWITCH=true
APP_EMAIL_SENT_COPY_MODE=DISABLED

BACKEND_HEALTHCHECK_MODE=actuator-readiness-v1
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO
