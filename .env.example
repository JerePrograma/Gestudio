# Required in production. Spring profile: dev, test or prod.
SPRING_PROFILES_ACTIVE=prod
# Required in production. JDBC URL for PostgreSQL.
SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/gestudio_db
# Required in production. Non-owner PostgreSQL application role protected by RLS.
SPRING_DATASOURCE_USERNAME=<set-application-user>
# Required secret in production. Never commit the real value.
SPRING_DATASOURCE_PASSWORD=<set-application-password>
# Required in production. Dedicated least-privilege control-plane connection.
APP_PLATFORM_DATASOURCE_URL=jdbc:postgresql://db-host:5432/gestudio_db
APP_PLATFORM_DATASOURCE_USERNAME=<set-control-plane-user>
APP_PLATFORM_DATASOURCE_PASSWORD=<set-control-plane-password>
# Required in production. A distinct owner/migration role; never use it for requests.
SPRING_FLYWAY_USER=<set-migration-user>
SPRING_FLYWAY_PASSWORD=<set-migration-password>
# Required in production. Keep validate; schema changes belong to Flyway.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Required in production. Enables forward-only Flyway migrations.
SPRING_FLYWAY_ENABLED=true
# Optional recovery setting. Keep false unless an existing untracked schema was reviewed.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
# Optional recovery setting. Baseline version used only when baseline-on-migrate is enabled.
SPRING_FLYWAY_BASELINE_VERSION=1

# Required secret in production, at least 32 characters. Never reuse this placeholder.
JWT_SECRET=<set-random-secret-at-least-32-characters>
# Required in production. Stable issuer checked when validating tokens.
JWT_ISSUER=gestudio
# Required in production. Access-token lifetime as an ISO-8601 duration.
JWT_ACCESS_TOKEN_TTL=PT15M
# Required in production. Refresh-token lifetime as an ISO-8601 duration.
JWT_REFRESH_TOKEN_TTL=P7D

# Dedicated platform-session contract. Keep its AES key independent from JWT_SECRET.
JWT_PLATFORM_AUDIENCE=<set-platform-audience>
APP_PLATFORM_ACCESS_TOKEN_TTL=PT5M
APP_PLATFORM_REFRESH_TOKEN_TTL=PT8H
APP_PLATFORM_STEP_UP_TTL=PT5M
APP_PLATFORM_MFA_ENCRYPTION_KEY=<set-independent-32-byte-base64-key>
APP_PLATFORM_MFA_KEY_VERSION=1
APP_PLATFORM_REFRESH_COOKIE_NAME=gestudio_platform_refresh
APP_PLATFORM_REFRESH_COOKIE_SECURE=true
APP_PLATFORM_REFRESH_COOKIE_SAME_SITE=Strict
APP_PLATFORM_REFRESH_COOKIE_DOMAIN=
APP_PLATFORM_REFRESH_COOKIE_PATH=/api/platform/auth

# Email remains fail-closed in every profile until every real-delivery guard is changed explicitly.
APP_EMAIL_ENABLED=false
APP_EMAIL_PROVIDER=NOOP
APP_EMAIL_DRY_RUN=true
APP_EMAIL_REAL_NETWORK_ALLOWED=false
APP_EMAIL_KILL_SWITCH=true
APP_EMAIL_FROM_ADDRESS=
APP_EMAIL_FROM_NAME=Gestudio
APP_EMAIL_SENT_COPY_MODE=DISABLED
APP_EMAIL_FAKE_OUTCOME=SUCCESS
# Gmail SMTP values are required only for explicitly authorized real delivery.
APP_EMAIL_GMAIL_HOST=
APP_EMAIL_GMAIL_PORT=587
APP_EMAIL_GMAIL_USERNAME=
# APP_EMAIL_GMAIL_APP_PASSWORD is intentionally omitted; supply only from a secret manager.
APP_EMAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
APP_EMAIL_SMTP_READ_TIMEOUT_MS=5000
APP_EMAIL_SMTP_WRITE_TIMEOUT_MS=5000
# Sent-copy values are required only for BEST_EFFORT. REQUIRED is rejected.
APP_EMAIL_SENT_COPY_HOST=
APP_EMAIL_SENT_COPY_PORT=993
APP_EMAIL_SENT_COPY_USERNAME=
# APP_EMAIL_SENT_COPY_APP_PASSWORD is intentionally omitted.
APP_EMAIL_SENT_COPY_FOLDER=
APP_EMAIL_SENT_COPY_CONNECTION_TIMEOUT_MS=5000
APP_EMAIL_SENT_COPY_READ_TIMEOUT_MS=5000

# Required in production. IANA business time zone.
APP_TIME_ZONE=America/Argentina/Buenos_Aires
# Required in production. Writable persistent directory for receipts.
APP_RECEIPTS_PATH=/var/lib/gestudio/receipts
# Required in production. Comma-separated HTTPS origins, without paths.
APP_CORS_ALLOWED_ORIGINS=https://app.example.invalid
# Optional. Production defaults to true; disable only for controlled maintenance.
APP_SCHEDULING_ENABLED=true
# Required secret in production. Protects /actuator/prometheus; use an independent value of at least 32 UTF-8 bytes.
APP_OBSERVABILITY_METRICS_TOKEN=<set-independent-random-metrics-token>
# Required by the current image/PDF asset resolver.
GESTUDIO_HOME=/opt/gestudio
# Optional. Backend HTTP port.
SERVER_PORT=8080
# Optional. Root log level; do not enable sensitive payload logging.
LOGGING_LEVEL_ROOT=INFO

# Optional source-export integration. Disabled by default and fail-closed.
APP_JERE_PLATFORM_STUDENT_EXPORT_ENABLED=false
# Stable internal deployment/academy identifier; never derive it from a display name.
APP_JERE_PLATFORM_STUDENT_EXPORT_ORGANIZATION_ID=
# Set the external Jere Platform tenant UUID explicitly outside Git.
APP_JERE_PLATFORM_STUDENT_EXPORT_TENANT_ID=
# Between 1 and 1000. Payloads are also limited to 1,000,000 bytes.
APP_JERE_PLATFORM_STUDENT_EXPORT_PAGE_SIZE=1000
# APP_JERE_PLATFORM_STUDENT_EXPORT_CURRENT_SECRET is intentionally omitted.
# Supply that independent secret from the runtime secret manager only.

# Required at frontend production build time. Must use HTTPS outside localhost.
VITE_API_BASE_URL=https://api.example.invalid/api
# Required at frontend production build time. IANA display time zone.
VITE_APP_TIME_ZONE=America/Argentina/Buenos_Aires

# Required by PostgreSQL Compose service. Database name.
POSTGRES_DB=gestudio_db
# Required by PostgreSQL Compose service. Database user.
POSTGRES_USER=<set-database-user>
# Required secret by PostgreSQL Compose service. Never commit the real value.
POSTGRES_PASSWORD=<set-database-password>
# Required by Compose. Non-owner role used by the application and protected by RLS.
POSTGRES_APP_USER=<set-application-user>
POSTGRES_APP_PASSWORD=<set-application-password>
# Required by Compose. Dedicated login inheriting only gestudio_platform.
POSTGRES_CONTROL_USER=<set-control-plane-user>
POSTGRES_CONTROL_PASSWORD=<set-control-plane-password>
# Optional Docker-only host port.
POSTGRES_PORT=5432
# Optional Docker-only host port.
BACKEND_PORT=8080
# Optional Docker-only host port.
FRONTEND_PORT=8081
# Optional Docker-only unique name; use a different value per parallel worktree.
COMPOSE_PROJECT_NAME=gestudio
# Optional deployment image override. Local Compose builds this name when absent.
BACKEND_IMAGE=gestudio-backend:local
# Optional deployment image override. Local Compose builds this name when absent.
FRONTEND_IMAGE=gestudio-frontend:local
