{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-pages-headers.mjs",
    "lint": "eslint .",
    "test": "node --test nginx/*.check.mjs && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:diff-coverage": "vitest run --config vite.diff-coverage.config.ts --coverage",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "quality:duplication": "jscpd src --min-lines 10 --min-tokens 70 --threshold 2 --ignore \"**/*.test.ts,**/*.test.tsx,**/*.spec.ts,**/*.spec.tsx\" --reporters console,json --output quality-reports/jscpd",
    "sbom": "cyclonedx-npm --output-file frontend-sbom.cdx.json --output-format JSON --spec-version 1.6 --validate",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-query": "^5.67.2",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "formik": "^2.4.6",
    "lucide-react": "^0.474.0",
    "next-themes": "^0.4.4",
    "react": "19.2.8",
    "react-datepicker": "^8.1.0",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "react-toastify": "^11.0.3",
    "tailwind-merge": "^3.0.2",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "autoprefixer": "^10.4.20",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^15.14.0",
    "jscpd": "5.0.14",
    "jsdom": "^29.1.1",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.2",
    "typescript-eslint": "8.65.0",
    "vite": "^6.0.5",
    "vitest": "4.1.10"
  }
}
